<Window x:Class="Land.Control.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="400"
        Title="{Binding Title}">
    <StackPanel Margin="10">
        <TextBlock Text="{Binding Question}" Margin="0,0,0,5"/>
        <TextBox x:Name="InputBox" Text="{Binding DefaultText, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Width="80" Margin="0,0,5,0" Click="OkButton_Click"/>
            <Button Content="Отмена" IsCancel="True" Width="80" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
